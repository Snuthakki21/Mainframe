<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IncludeDatabaseDrivers Condition="'$(IncludeDatabaseDrivers)' == ''">true</IncludeDatabaseDrivers>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeDatabaseDrivers)' == 'true'">
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
  </ItemGroup>
</Project>
